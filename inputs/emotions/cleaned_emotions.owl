  <conc:hasQualityDimension rdf:resource="http://example.org/conceptual_spaces.owl#PAD_pleasure"/>
  <conc:hasQualityDimension rdf:resource="http://example.org/conceptual_spaces.owl#PAD_dominance"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pad</rdfs:label>
</rdf:Description>

<rdf:Description rdf:about="http://example.org/conceptual_spaces.owl#PAD_arousal">
  <hasRangeMin rdf:datatype="http://www.w3.org/2001/XMLSchema#string">0</hasRangeMin>
  <hasRangeMax rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1</hasRangeMax>
  <conc:hasRange rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[0, 1]</conc:hasRange>
  <hasDefinition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">amount of physiological change in the person's body</hasDefinition>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">arousal</rdfs:label>
</rdf:Description>

<rdf:Description rdf:about="http://example.org/conceptual_spaces.owl#PAD_pleasure">
  <hasRangeMin rdf:datatype="http://www.w3.org/2001/XMLSchema#string">-1</hasRangeMin>
  <hasRangeMax rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1</hasRangeMax>
  <conc:hasRange rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[-1, 1]</conc:hasRange>
  <hasDefinition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">degree of pleasantness or unpleasantness of an emotion</hasDefinition>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pleasure</rdfs:label>
</rdf:Description>

<rdf:Description rdf:about="http://example.org/conceptual_spaces.owl#PAD_dominance">
  <hasRangeMin rdf:datatype="http://www.w3.org/2001/XMLSchema#string">-1</hasRangeMin>
  <hasRangeMax rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1</hasRangeMax>
  <conc:hasRange rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[-1, 1]</conc:hasRange>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">dominance</rdfs:label>
  <hasDefinition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the feeling of being in control of the situation vs being controlled</hasDefinition>
</rdf:Description>

<rdf:Description rdf:about="http://example.org/conceptual_spaces.owl#Osgood">
  <conc:hasQualityDimension rdf:resource="http://example.org/conceptual_spaces.owl#Osgood_activity"/>
  <conc:hasQualityDimension rdf:resource="http://example.org/conceptual_spaces.owl#Osgood_potency"/>
  <conc:hasQualityDimension rdf:resource="http://example.org/conceptual_spaces.owl#Osgood_evaluation"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">osgood</rdfs:label>
</rdf:Description>

<rdf:Description rdf:about="http://example.org/conceptual_spaces.owl#Osgood_activity">
  <hasRangeMin rdf:datatype="http://www.w3.org/2001/XMLSchema#string">0</hasRangeMin>
  <hasRangeMax rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1</hasRangeMax>
  <conc:hasRange rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[0, 1]</conc:hasRange>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">activity</rdfs:label>
  <hasDefinition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">amount of physiological change in the person's body</hasDefinition>
</rdf:Description>

<rdf:Description rdf:about="http://example.org/conceptual_spaces.owl#Osgood_potency">
  <hasRangeMin rdf:datatype="http://www.w3.org/2001/XMLSchema#string">0</hasRangeMin>
  <hasRangeMax rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1</hasRangeMax>
  <conc:hasRange rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[0, 1]</conc:hasRange>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">potency</rdfs:label>
  <hasDefinition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the perceived strength, dominance, or control inherent in an emotion.</hasDefinition>
</rdf:Description>

<rdf:Description rdf:about="http://example.org/conceptual_spaces.owl#Osgood_evaluation">
  <hasRangeMin rdf:datatype="http://www.w3.org/2001/XMLSchema#string">-1</hasRangeMin>
  <hasRangeMax rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1</hasRangeMax>
  <conc:hasRange rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[-1, 1]</conc:hasRange>
  <hasDefinition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">degree of pleasantness or unpleasantness of an emotion</hasDefinition>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">evaluation</rdfs:label>
</rdf:Description>

