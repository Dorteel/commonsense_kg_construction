  <rdfs:subClassOf rdf:resource="http://example.org/conceptual_spaces.owl#Concept"/>
</owl:Class>

<owl:NamedIndividual rdf:about="#Interest">
  <rdf:type rdf:resource="#Emotion"/>
  <hasSource_APA rdf:datatype="http://www.w3.org/2001/XMLSchema#string">-</hasSource_APA>
  <hasSynset rdf:datatype="http://www.w3.org/2001/XMLSchema#string">02678663</hasSynset>
  <hasDefinition_APA rdf:datatype="http://www.w3.org/2001/XMLSchema#string">attitude characterized by a need or desire to give selective attention to something that is significant to the individual, such as an activity, goal, or research area.</hasDefinition_APA>
  <hasDefinition_SentiWordNet rdf:datatype="http://www.w3.org/2001/XMLSchema#string">be of importance or consequence; \"This matters to me!\"\n</hasDefinition_SentiWordNet>
  <hasSource_Cambridge rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.cambridge.org/dictionary/english/interest</hasSource_Cambridge>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">interest</rdfs:label>
  <hasDefinition_Cambridge rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the feeling of wanting to give your attention to something or of wanting to be involved with and to discover more about something</hasDefinition_Cambridge>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Serenity">
  <rdf:type rdf:resource="#Emotion"/>
  <hasDefinition_APA rdf:datatype="http://www.w3.org/2001/XMLSchema#string">-</hasDefinition_APA>
  <hasSource_APA rdf:datatype="http://www.w3.org/2001/XMLSchema#string">-</hasSource_APA>
  <hasSynset rdf:datatype="http://www.w3.org/2001/XMLSchema#string">04904352</hasSynset>
  <hasDefinition_SentiWordNet rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a disposition free from stress or emotion\n</hasDefinition_SentiWordNet>
  <hasSource_Cambridge rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.cambridge.org/dictionary/english/serenity</hasSource_Cambridge>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">serenity</rdfs:label>
  <hasDefinition_Cambridge rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the quality of being peaceful and calm</hasDefinition_Cambridge>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Acceptance">
  <rdf:type rdf:resource="#Emotion"/>
  <hasSource_APA rdf:datatype="http://www.w3.org/2001/XMLSchema#string">-</hasSource_APA>
  <hasSource_Cambridge rdf:datatype="http://www.w3.org/2001/XMLSchema#string">-</hasSource_Cambridge>
  <hasSynset rdf:datatype="http://www.w3.org/2001/XMLSchema#string">04638175</hasSynset>
  <hasDefinition_SentiWordNet rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a disposition to tolerate or accept people or situations; \"all people should practice toleration and live together in peace\"\n</hasDefinition_SentiWordNet>
  <hasDefinition_APA rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a favorable attitude toward an idea, situation, person, or group. In the context of psychotherapy and counseling, it is the receptive, nonjudgmental attitude of therapists or counselors, which conveys an implicit respect and regard for their clients as individuals.</hasDefinition_APA>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">acceptance</rdfs:label>
  <hasDefinition_Cambridge rdf:datatype="http://www.w3.org/2001/XMLSchema#string">general agreement that something is satisfactory or right, or that someone should be included in a group</hasDefinition_Cambridge>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Anticipation">
  <rdf:type rdf:resource="#Emotion"/>
  <hasSource_APA rdf:datatype="http://www.w3.org/2001/XMLSchema#string">-</hasSource_APA>
  <hasSynset rdf:datatype="http://www.w3.org/2001/XMLSchema#string">14486122</hasSynset>
  <hasDefinition_Cambridge rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a feeling of excitement about something that is going to happen in the near future</hasDefinition_Cambridge>
  <hasDefinition_SentiWordNet rdf:datatype="http://www.w3.org/2001/XMLSchema#string">anticipating with confidence of fulfillment\n</hasDefinition_SentiWordNet>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">anticipation</rdfs:label>
  <hasSource_Cambridge rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.cambridge.org/dictionary/english/anticipation</hasSource_Cambridge>
  <hasDefinition_APA rdf:datatype="http://www.w3.org/2001/XMLSchema#string">looking forward to a future event or state, sometimes with an affective component (e.g., pleasure, anxiety)</hasDefinition_APA>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Optimism">
  <rdf:type rdf:resource="#Emotion"/>
  <hasSynset rdf:datatype="http://www.w3.org/2001/XMLSchema#string">07541558</hasSynset>
  <hasDefinition_APA rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hopefulness: the attitude that good things will happen and that peopleâ€™s wishes or aims will ultimately be fulfilled</hasDefinition_APA>
  <hasSource_APA rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.apa.org/optimism</hasSource_APA>
  <hasSource_Cambridge rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.cambridge.org/dictionary/english/optimism</hasSource_Cambridge>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">optimism</rdfs:label>
  <hasDefinition_SentiWordNet rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the optimistic feeling that all is going to turn out well\n</hasDefinition_SentiWordNet>
  <hasDefinition_Cambridge rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the quality of being full of hope and emphasizing the good parts of a situation, or a belief that something good will happen</hasDefinition_Cambridge>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Joy">
  <rdf:type rdf:resource="#Emotion"/>
  <hasSynset rdf:datatype="http://www.w3.org/2001/XMLSchema#string">01813884</hasSynset>
  <hasDefinition_APA rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a feeling of extreme gladness, delight, or exultation of the spirit arising from a sense of well-being or satisfaction.</hasDefinition_APA>
  <hasDefinition_SentiWordNet rdf:datatype="http://www.w3.org/2001/XMLSchema#string">feel happiness or joy</hasDefinition_SentiWordNet>
  <hasDefinition_Cambridge rdf:datatype="http://www.w3.org/2001/XMLSchema#string">great happiness</hasDefinition_Cambridge>
  <hasSource_APA rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.apa.org/joy</hasSource_APA>
  <hasSource_Cambridge rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.cambridge.org/dictionary/english/joy</hasSource_Cambridge>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">joy</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Love">
  <rdf:type rdf:resource="#Emotion"/>
  <hasSynset rdf:datatype="http://www.w3.org/2001/XMLSchema#string">01775164</hasSynset>
  <hasDefinition_APA rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a complex emotion involving strong feelings of affection and tenderness for the love object, pleasurable sensations in their presence, devotion to their well-being, and sensitivity to their reactions to oneself.</hasDefinition_APA>
  <hasDefinition_SentiWordNet rdf:datatype="http://www.w3.org/2001/XMLSchema#string">have a great affection or liking for; \"I love French food\"; \"She loves her boss and works hard for him\"</hasDefinition_SentiWordNet>
  <hasSource_APA rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.apa.org/love</hasSource_APA>
  <hasSource_Cambridge rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.cambridge.org/dictionary/english/love</hasSource_Cambridge>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">love</rdfs:label>
  <hasDefinition_Cambridge rdf:datatype="http://www.w3.org/2001/XMLSchema#string">to like something very much</hasDefinition_Cambridge>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Trust">
  <rdf:type rdf:resource="#Emotion"/>
  <hasSynset rdf:datatype="http://www.w3.org/2001/XMLSchema#string">00688377</hasSynset>
  <hasDefinition_SentiWordNet rdf:datatype="http://www.w3.org/2001/XMLSchema#string">have confidence or faith in; \"We can trust in God\"; \"Rely on your friends\"; \"bank on your good education\"; \"I swear by my grandmother's recipes\"</hasDefinition_SentiWordNet>
  <hasSource_APA rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.apa.org/trust</hasSource_APA>
  <hasSource_Cambridge rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.cambridge.org/dictionary/english/trust</hasSource_Cambridge>
  <hasDefinition_APA rdf:datatype="http://www.w3.org/2001/XMLSchema#string">reliance on or confidence in the dependability of someone or something</hasDefinition_APA>
  <hasDefinition_Cambridge rdf:datatype="http://www.w3.org/2001/XMLSchema#string">to believe that someone is good and honest and will not harm you, or that something is safe and reliable</hasDefinition_Cambridge>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trust</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Aggressiveness">
  <rdf:type rdf:resource="#Emotion"/>
  <hasSynset rdf:datatype="http://www.w3.org/2001/XMLSchema#string">01244846</hasSynset>
  <hasDefinition_APA rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a tendency toward social dominance, threatening behavior, and hostility. It may occur sporadically or be a characteristic trait of an individual</hasDefinition_APA>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">aggressiveness</rdfs:label>
  <hasDefinition_SentiWordNet rdf:datatype="http://www.w3.org/2001/XMLSchema#string">characteristic of an enemy or one eager to fight; \"aggressive acts against another country\"; \"a belligerent tone\"</hasDefinition_SentiWordNet>
  <hasSource_APA rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.apa.org/aggressiveness</hasSource_APA>
  <hasSource_Cambridge rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.cambridge.org/dictionary/english/aggressiveness</hasSource_Cambridge>
  <hasDefinition_Cambridge rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the quality of being likely to attack other people or animals, or to behave in a violent or angry way towards them</hasDefinition_Cambridge>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Vigilance">
  <rdf:type rdf:resource="#Emotion"/>
  <hasSynset rdf:datatype="http://www.w3.org/2001/XMLSchema#string">04664778</hasSynset>
  <hasDefinition_APA rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a state of extreme awareness and watchfulness directed by one or more members of a group toward the environment, often toward potential threats (e.g., predators, intruders, enemy forces in combat).</hasDefinition_APA>
  <hasSource_APA rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.apa.org/vigilance</hasSource_APA>
  <hasSource_Cambridge rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.cambridge.org/dictionary/english/vigilance</hasSource_Cambridge>
  <hasDefinition_Cambridge rdf:datatype="http://www.w3.org/2001/XMLSchema#string">more careful attention, especially in order to notice possible danger</hasDefinition_Cambridge>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">vigilance</rdfs:label>
  <hasDefinition_SentiWordNet rdf:datatype="http://www.w3.org/2001/XMLSchema#string">vigilant attentiveness; \"he keeps a weather eye open for trouble\""</hasDefinition_SentiWordNet>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Ecstasy">
  <rdf:type rdf:resource="#Emotion"/>
  <hasSynset rdf:datatype="http://www.w3.org/2001/XMLSchema#string">13986372</hasSynset>
  <hasDefinition_APA rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a feeling of intense pleasure and elation, including that experienced in some mystical states, during orgasm, with aesthetic reveries, and in drug-induced states.</hasDefinition_APA>
  <hasDefinition_SentiWordNet rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a state of being carried away by overwhelming emotion; \"listening to sweet music in a perfect rapture\"- Charles Dickens"</hasDefinition_SentiWordNet>
  <hasDefinition_Cambridge rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a state of extreme happiness, especially when feeling pleasure</hasDefinition_Cambridge>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ecstasy</rdfs:label>
  <hasSource_APA rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.apa.org/ecstasy</hasSource_APA>
  <hasSource_Cambridge rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.cambridge.org/dictionary/english/ecstasy</hasSource_Cambridge>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Admiration">
  <rdf:type rdf:resource="#Emotion"/>
  <hasDefinition_APA rdf:datatype="http://www.w3.org/2001/XMLSchema#string">-</hasDefinition_APA>
  <hasSource_APA rdf:datatype="http://www.w3.org/2001/XMLSchema#string">-</hasSource_APA>
  <hasSynset rdf:datatype="http://www.w3.org/2001/XMLSchema#string">07500741</hasSynset>
  <hasDefinition_SentiWordNet rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a feeling of delighted approval and liking</hasDefinition_SentiWordNet>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">admiration</rdfs:label>
  <hasSource_Cambridge rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.cambridge.org/dictionary/english/admiration</hasSource_Cambridge>
  <hasDefinition_Cambridge rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the feeling of admiring someone or something</hasDefinition_Cambridge>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Submission">
  <rdf:type rdf:resource="#Emotion"/>
  <hasSynset rdf:datatype="http://www.w3.org/2001/XMLSchema#string">07509325</hasSynset>
  <hasDefinition_Cambridge rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a willingness to allow control by other people or animals, or behaviour that shows this</hasDefinition_Cambridge>
  <hasDefinition_APA rdf:datatype="http://www.w3.org/2001/XMLSchema#string">compliance with or surrender to the requests, demands, or will of others.</hasDefinition_APA>
  <hasSource_APA rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.apa.org/submission</hasSource_APA>
  <hasSource_Cambridge rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.cambridge.org/dictionary/english/submissiveness</hasSource_Cambridge>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">submission</rdfs:label>
  <hasDefinition_SentiWordNet rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the feeling of patient, submissive humbleness</hasDefinition_SentiWordNet>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Annoyance">
  <rdf:type rdf:resource="#Emotion"/>
  <hasDefinition_APA rdf:datatype="http://www.w3.org/2001/XMLSchema#string">-</hasDefinition_APA>
  <hasSource_APA rdf:datatype="http://www.w3.org/2001/XMLSchema#string">-</hasSource_APA>
  <hasSynset rdf:datatype="http://www.w3.org/2001/XMLSchema#string">07518261</hasSynset>
  <hasDefinition_SentiWordNet rdf:datatype="http://www.w3.org/2001/XMLSchema#string">anger produced by some annoying irritation</hasDefinition_SentiWordNet>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">annoyance</rdfs:label>
  <hasSource_Cambridge rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.cambridge.org/dictionary/english/annoyance</hasSource_Cambridge>
  <hasDefinition_Cambridge rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the feeling or state of being annoyed</hasDefinition_Cambridge>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Anger">
  <rdf:type rdf:resource="#Emotion"/>
  <hasSynset rdf:datatype="http://www.w3.org/2001/XMLSchema#string">14036539</hasSynset>
  <hasDefinition_Cambridge rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a strong feeling that makes you want to hurt someone or be unpleasant because of something unfair or unkind that has happened</hasDefinition_Cambridge>
  <hasDefinition_APA rdf:datatype="http://www.w3.org/2001/XMLSchema#string">an emotion characterized by tension and hostility arising from frustration, real or imagined injury by another, or perceived injustice. It can manifest itself in behaviors designed to remove the object of the anger (e.g., determined action) or behaviors designed merely to express the emotion (e.g., swearing).</hasDefinition_APA>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">anger</rdfs:label>
  <hasSource_APA rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.apa.org/anger</hasSource_APA>
  <hasSource_Cambridge rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.cambridge.org/dictionary/english/anger</hasSource_Cambridge>
  <hasDefinition_SentiWordNet rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the state of being angry</hasDefinition_SentiWordNet>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Rage">
  <rdf:type rdf:resource="#Emotion"/>
  <hasDefinition_Cambridge rdf:datatype="http://www.w3.org/2001/XMLSchema#string">(a period of) extreme or violent anger</hasDefinition_Cambridge>
  <hasSynset rdf:datatype="http://www.w3.org/2001/XMLSchema#string">07516997</hasSynset>
  <hasDefinition_SentiWordNet rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a feeling of intense anger; \"hell hath no fury like a woman scorned\"; \"his face turned red with rage\"</hasDefinition_SentiWordNet>
  <hasSource_APA rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.apa.org/rage</hasSource_APA>
  <hasSource_Cambridge rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.cambridge.org/dictionary/english/rage</hasSource_Cambridge>
  <hasDefinition_APA rdf:datatype="http://www.w3.org/2001/XMLSchema#string">intense, typically uncontrolled anger</hasDefinition_APA>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">rage</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Terror">
  <rdf:type rdf:resource="#Emotion"/>
  <hasSynset rdf:datatype="http://www.w3.org/2001/XMLSchema#string">07520612</hasSynset>
  <hasDefinition_SentiWordNet rdf:datatype="http://www.w3.org/2001/XMLSchema#string">an overwhelming feeling of fear and anxiety</hasDefinition_SentiWordNet>
  <hasDefinition_Cambridge rdf:datatype="http://www.w3.org/2001/XMLSchema#string">extreme fear</hasDefinition_Cambridge>
  <hasSource_APA rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.apa.org/terror</hasSource_APA>
  <hasSource_Cambridge rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.cambridge.org/dictionary/english/terror</hasSource_Cambridge>
  <hasDefinition_APA rdf:datatype="http://www.w3.org/2001/XMLSchema#string">intense and overwhelming fear</hasDefinition_APA>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">terror</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Fear">
  <rdf:type rdf:resource="#Emotion"/>
  <hasSynset rdf:datatype="http://www.w3.org/2001/XMLSchema#string">07519253</hasSynset>
  <hasDefinition_APA rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a basic, intense emotion aroused by the detection of imminent threat, involving an immediate alarm reaction that mobilizes the organism by triggering a set of physiological changes</hasDefinition_APA>
  <hasDefinition_SentiWordNet rdf:datatype="http://www.w3.org/2001/XMLSchema#string">an emotion experienced in anticipation of some specific pain or danger (usually accompanied by a desire to flee or fight)</hasDefinition_SentiWordNet>
  <hasDefinition_Cambridge rdf:datatype="http://www.w3.org/2001/XMLSchema#string">an unpleasant emotion or thought that you have when you are frightened or worried by something dangerous, painful, or bad that is happening or might happen</hasDefinition_Cambridge>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fear</rdfs:label>
  <hasSource_APA rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.apa.org/fear</hasSource_APA>
  <hasSource_Cambridge rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.cambridge.org/dictionary/english/fear</hasSource_Cambridge>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Apprehension">
  <rdf:type rdf:resource="#Emotion"/>
  <hasSynset rdf:datatype="http://www.w3.org/2001/XMLSchema#string">07521674</hasSynset>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">apprehension</rdfs:label>
  <hasDefinition_SentiWordNet rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fearful expectation or anticipation; \"the student looked around the examination room with apprehension\"</hasDefinition_SentiWordNet>
  <hasSource_APA rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.apa.org/apprehension</hasSource_APA>
  <hasSource_Cambridge rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.cambridge.org/dictionary/english/apprehension</hasSource_Cambridge>
  <hasDefinition_APA rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uneasiness or dread about an upcoming event or the future generally</hasDefinition_APA>
  <hasDefinition_Cambridge rdf:datatype="http://www.w3.org/2001/XMLSchema#string">worry about the future, or a fear that something unpleasant is going to happen</hasDefinition_Cambridge>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Contempt">
  <rdf:type rdf:resource="#Emotion"/>
  <hasSynset rdf:datatype="http://www.w3.org/2001/XMLSchema#string">07502980</hasSynset>
  <hasDefinition_Cambridge rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a strong feeling of disliking and having no respect for someone or something</hasDefinition_Cambridge>
  <hasDefinition_APA rdf:datatype="http://www.w3.org/2001/XMLSchema#string">an emotion characterized by negative regard for anything or anybody considered to be inferior, vile, or worthless</hasDefinition_APA>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">contempt</rdfs:label>
  <hasSource_APA rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.apa.org/contempt</hasSource_APA>
  <hasSource_Cambridge rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.cambridge.org/dictionary/english/contempt</hasSource_Cambridge>
  <hasDefinition_SentiWordNet rdf:datatype="http://www.w3.org/2001/XMLSchema#string">lack of respect accompanied by a feeling of intense dislike; \"he was held in contempt\"; \"the despite in which outsiders were held is legendary\"</hasDefinition_SentiWordNet>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Loathing">
  <rdf:type rdf:resource="#Emotion"/>
  <hasDefinition_APA rdf:datatype="http://www.w3.org/2001/XMLSchema#string">-</hasDefinition_APA>
  <hasSource_APA rdf:datatype="http://www.w3.org/2001/XMLSchema#string">-</hasSource_APA>
  <hasSynset rdf:datatype="http://www.w3.org/2001/XMLSchema#string">07503430</hasSynset>
  <hasDefinition_Cambridge rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a strong feeling of hating someone or something</hasDefinition_Cambridge>
  <hasDefinition_SentiWordNet rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hate coupled with disgust</hasDefinition_SentiWordNet>
  <hasSource_Cambridge rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.cambridge.org/dictionary/english/loathing</hasSource_Cambridge>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">loathing</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Grief">
  <rdf:type rdf:resource="#Emotion"/>
  <hasSynset rdf:datatype="http://www.w3.org/2001/XMLSchema#string">07535010</hasSynset>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">grief</rdfs:label>
  <hasSource_APA rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.apa.org/grief</hasSource_APA>
  <hasSource_Cambridge rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.cambridge.org/dictionary/english/grief</hasSource_Cambridge>
  <hasDefinition_SentiWordNet rdf:datatype="http://www.w3.org/2001/XMLSchema#string">intense sorrow caused by loss of a loved one (especially by death)</hasDefinition_SentiWordNet>
  <hasDefinition_APA rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the anguish experienced after significant loss, usually the death of a beloved person.</hasDefinition_APA>
  <hasDefinition_Cambridge rdf:datatype="http://www.w3.org/2001/XMLSchema#string">very great sadness, especially at the death of someone</hasDefinition_Cambridge>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Amazement">
  <rdf:type rdf:resource="#Emotion"/>
  <hasDefinition_APA rdf:datatype="http://www.w3.org/2001/XMLSchema#string">-</hasDefinition_APA>
  <hasSource_APA rdf:datatype="http://www.w3.org/2001/XMLSchema#string">-</hasSource_APA>
  <hasSynset rdf:datatype="http://www.w3.org/2001/XMLSchema#string">07509572</hasSynset>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">amazement</rdfs:label>
  <hasDefinition_Cambridge rdf:datatype="http://www.w3.org/2001/XMLSchema#string">extreme surprise</hasDefinition_Cambridge>
  <hasSource_Cambridge rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.cambridge.org/dictionary/english/amazement</hasSource_Cambridge>
  <hasDefinition_SentiWordNet rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the feeling that accompanies something extremely surprising; \"he looked at me in astonishment\"</hasDefinition_SentiWordNet>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Awe">
  <rdf:type rdf:resource="#Emotion"/>
  <hasSynset rdf:datatype="http://www.w3.org/2001/XMLSchema#string">07510184</hasSynset>
  <hasDefinition_Cambridge rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a feeling of great respect sometimes mixed with fear or surprise</hasDefinition_Cambridge>
  <hasDefinition_SentiWordNet rdf:datatype="http://www.w3.org/2001/XMLSchema#string">an overwhelming feeling of wonder or admiration; \"he stared over the edge with a feeling of awe\"</hasDefinition_SentiWordNet>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">awe</rdfs:label>
  <hasSource_APA rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.apa.org/awe</hasSource_APA>
  <hasSource_Cambridge rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.cambridge.org/dictionary/english/awe</hasSource_Cambridge>
  <hasDefinition_APA rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the experience of admiration and elevation in response to physical beauty, displays of exceptional ability, or moral goodness.</hasDefinition_APA>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Disgust">
  <rdf:type rdf:resource="#Emotion"/>
  <hasSynset rdf:datatype="http://www.w3.org/2001/XMLSchema#string">07503260</hasSynset>
  <hasDefinition_APA rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a strong aversion, for example, to the taste, smell, or touch of something deemed revolting, or toward a person or behavior deemed morally repugnant</hasDefinition_APA>
  <hasDefinition_Cambridge rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a strong feeling of disapproval and dislike at a situation, person's behaviour, etc.</hasDefinition_Cambridge>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">disgust</rdfs:label>
  <hasSource_APA rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.apa.org/disgust</hasSource_APA>
  <hasSource_Cambridge rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.cambridge.org/dictionary/english/disgust</hasSource_Cambridge>
  <hasDefinition_SentiWordNet rdf:datatype="http://www.w3.org/2001/XMLSchema#string">strong feelings of dislike</hasDefinition_SentiWordNet>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Remorse">
  <rdf:type rdf:resource="#Emotion"/>
  <hasSynset rdf:datatype="http://www.w3.org/2001/XMLSchema#string">07536074</hasSynset>
  <hasDefinition_SentiWordNet rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a feeling of deep regret (usually for some misdeed)</hasDefinition_SentiWordNet>
  <hasDefinition_Cambridge rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a feeling of sadness and being sorry for something you have done</hasDefinition_Cambridge>
  <hasDefinition_APA rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a strong sense of guilt and regret for a past action</hasDefinition_APA>
  <hasSource_APA rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.apa.org/remorse</hasSource_APA>
  <hasSource_Cambridge rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.cambridge.org/dictionary/english/remorse</hasSource_Cambridge>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">remorse</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Sadness">
  <rdf:type rdf:resource="#Emotion"/>
  <hasSynset rdf:datatype="http://www.w3.org/2001/XMLSchema#string">07532440</hasSynset>
  <hasDefinition_APA rdf:datatype="http://www.w3.org/2001/XMLSchema#string">an emotional state of unhappiness, ranging in intensity from mild to extreme and usually aroused by the loss of something that is highly valued (e.g., by the rupture of a relationship).</hasDefinition_APA>
  <hasDefinition_SentiWordNet rdf:datatype="http://www.w3.org/2001/XMLSchema#string">emotions experienced when not in a state of well-being</hasDefinition_SentiWordNet>
  <hasSource_APA rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.apa.org/sadness</hasSource_APA>
  <hasSource_Cambridge rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.cambridge.org/dictionary/english/sadness</hasSource_Cambridge>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sadness</rdfs:label>
  <hasDefinition_Cambridge rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the feeling of being unhappy, especially because something bad has happened</hasDefinition_Cambridge>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Disappointment">
  <rdf:type rdf:resource="#Emotion"/>
  <hasDefinition_APA rdf:datatype="http://www.w3.org/2001/XMLSchema#string">-</hasDefinition_APA>
  <hasSource_APA rdf:datatype="http://www.w3.org/2001/XMLSchema#string">-</hasSource_APA>
  <hasSynset rdf:datatype="http://www.w3.org/2001/XMLSchema#string">07540602</hasSynset>
  <hasDefinition_SentiWordNet rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a feeling of dissatisfaction that results when your expectations are not realized; \"his hopes were so high he was doomed to disappointment\"</hasDefinition_SentiWordNet>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">disappointment</rdfs:label>
  <hasSource_Cambridge rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.cambridge.org/dictionary/english/disappointment</hasSource_Cambridge>
  <hasDefinition_Cambridge rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the feeling of being disappointed</hasDefinition_Cambridge>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Surprise">
  <rdf:type rdf:resource="#Emotion"/>
  <hasSynset rdf:datatype="http://www.w3.org/2001/XMLSchema#string">07510348</hasSynset>
  <hasDefinition_APA rdf:datatype="http://www.w3.org/2001/XMLSchema#string">an emotion typically resulting from the violation of an expectation or the detection of novelty in the environment.</hasDefinition_APA>
  <hasSource_APA rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.apa.org/surprise</hasSource_APA>
  <hasSource_Cambridge rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.cambridge.org/dictionary/english/surprise</hasSource_Cambridge>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">surprise</rdfs:label>
  <hasDefinition_SentiWordNet rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the astonishment you feel when something totally unexpected happens to you</hasDefinition_SentiWordNet>
  <hasDefinition_Cambridge rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the feeling caused by something unexpected happening</hasDefinition_Cambridge>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Boredom">
  <rdf:type rdf:resource="#Emotion"/>
  <hasSynset rdf:datatype="http://www.w3.org/2001/XMLSchema#string">07539790</hasSynset>
  <hasDefinition_APA rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a state of weariness or ennui resulting from a lack of engagement with stimuli in the environment.</hasDefinition_APA>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">boredom</rdfs:label>
  <hasSource_APA rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.apa.org/boredom</hasSource_APA>
  <hasSource_Cambridge rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.cambridge.org/dictionary/english/boredom</hasSource_Cambridge>
  <hasDefinition_SentiWordNet rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the feeling of being bored by something tedious</hasDefinition_SentiWordNet>
  <hasDefinition_Cambridge rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the state of being bored</hasDefinition_Cambridge>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Pensiveness">
  <rdf:type rdf:resource="#Emotion"/>
  <hasDefinition_APA rdf:datatype="http://www.w3.org/2001/XMLSchema#string">-</hasDefinition_APA>
  <hasSource_APA rdf:datatype="http://www.w3.org/2001/XMLSchema#string">-</hasSource_APA>
  <hasSynset rdf:datatype="http://www.w3.org/2001/XMLSchema#string">04660805</hasSynset>
  <hasDefinition_SentiWordNet rdf:datatype="http://www.w3.org/2001/XMLSchema#string">deep serious thoughtfulness</hasDefinition_SentiWordNet>
  <hasSource_Cambridge rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.cambridge.org/dictionary/english/pensive</hasSource_Cambridge>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pensiveness</rdfs:label>
  <hasDefinition_Cambridge rdf:datatype="http://www.w3.org/2001/XMLSchema#string">thinking in a quiet way, often with a serious expression on your face</hasDefinition_Cambridge>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Distraction">
  <rdf:type rdf:resource="#Emotion"/>
  <hasSynset rdf:datatype="http://www.w3.org/2001/XMLSchema#string">05684440</hasSynset>
  <hasSource_APA rdf:datatype="http://www.w3.org/2001/XMLSchema#string">dictionary.apa.org/distractibility</hasSource_APA>
  <hasDefinition_APA rdf:datatype="http://www.w3.org/2001/XMLSchema#string">difficulty in maintaining attention or a tendency to be easily diverted from the matter at hand</hasDefinition_APA>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">distraction</rdfs:label>
  <hasSource_Cambridge rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://dictionary.cambridge.org/dictionary/english/distraction</hasSource_Cambridge>
  <hasDefinition_SentiWordNet rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mental turmoil; \"he drives me to distraction\"</hasDefinition_SentiWordNet>
  <hasDefinition_Cambridge rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the state of being very bored or annoyed</hasDefinition_Cambridge>
</owl:NamedIndividual>

